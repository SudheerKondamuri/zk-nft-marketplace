{
  "name": "zk-nft-marketplace",
  "version": "1.0.0",
  "description": "ZK-SNARK enabled confidential and verifiable NFT Marketplace transaction protocol",
  "main": "index.js",
  "scripts": {
    "compile:circuits": "bash scripts/compile_circuits.sh",
    "setup:circuits": "bash scripts/setup_circuits.sh",
    "generate:proof": "node scripts/generate_proof.js",
    "verify:proof": "node scripts/verify_proof.js",
    "test:circuit": "mocha test/circuit.test.js --timeout 100000",
    "test:contracts": "npx hardhat test",
    "test": "npx hardhat test && mocha test/circuit.test.js --timeout 100000",
    "build": "npx hardhat compile"
  },
  "keywords": [
    "zk-snark",
    "circom",
    "snarkjs",
    "nft",
    "marketplace",
    "solidity",
    "hardhat"
  ],
  "author": "Kondamuri Satya Sudheer",
  "license": "MIT",
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "^7.0.0",
    "@openzeppelin/contracts": "^5.6.1",
    "chai": "^6.3.0",
    "circomlib": "^2.0.5",
    "circomlibjs": "^0.1.7",
    "hardhat": "^3.22.0",
    "mocha": "^12.0.3",
    "snarkjs": "^0.7.6"
  }
}
